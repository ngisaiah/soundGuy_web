# Supabase — get these from your Supabase project dashboard
# https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # never expose this on the client

# These VITE_ prefixed vars are injected into the browser bundle by Vite
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...    # from dashboard > webhooks > signing secret

# Create a Product + one-time Price in the Stripe Dashboard ($19.99 USD)
# then paste the Price ID here, e.g. price_1ABC123...
SOUNDGUY_PRICE_ID=price_...

# The base URL of this site — used to build Stripe success/cancel redirect URLs
# In production set this to https://soundguy.app (or your real domain)
# Locally: http://localhost:5173 (Vite dev server) or http://localhost:3000 (vercel dev)
VITE_APP_URL=http://localhost:5173

# PostHog — project settings > Project Variables
VITE_POSTHOG_TOKEN=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Contact form — Resend API key must stay server-side, never prefix it with VITE_
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=support@sound-guy.io
